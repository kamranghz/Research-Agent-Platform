# Environment
# LLM provider for the Researcher: ollama (local default) | nvidia | groq
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDERS=
NVIDIA_RESEARCHER_MODEL=nvidia/nemotron-3-super-120b-a12b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings: ollama (local default) | nvidia (hosted)
EMBEDDING_PROVIDER=ollama
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Public demo lock-down (browser off, memory off, file_reader -> datasets/,
# per-session question cap). Leave 0 locally.
DEMO_MODE=0
DEMO_MAX_QUESTIONS_PER_SESSION=5
DEMO_MAX_QUESTIONS_TOTAL=300

OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_TEMPERATURE=0

# Vector stores
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=research_documents
LLAMAINDEX_CHROMA_COLLECTION_NAME=research_documents_llamaindex

# Memory
MEMORY_BACKEND=memory
SQLITE_CHECKPOINT_PATH=data/checkpoints.sqlite
ENABLE_LONG_TERM_MEMORY=true
LONG_TERM_MEMORY_COLLECTION=agent_long_term_memory

# External services
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REVIEWER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
TAVILY_API_KEY=

# MCP
MCP_CALL_TIMEOUT_SECONDS=60
